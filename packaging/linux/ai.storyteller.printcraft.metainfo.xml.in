<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.printcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>PDFThing</name>
  <summary>Draw, sketch and mark up PDFs</summary>
  <developer id="ai.storyteller">
    <name>PDFThing contributors</name>
  </developer>
  <description>
    <p>
      PDFThing is a PDF app built for freehand drawing: sketch on a blank page, or draw, write and mark up any PDF
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.printcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.printcraft</icon>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>printcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
